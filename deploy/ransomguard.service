[Unit]
Description=RansomGuard ransomware detection engine (headless)
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=/media/MySpace/Programming_Files/ransom_engine
Environment=PYTHONUNBUFFERED=1
# Add more folders with e.g.  --watch %h/Documents   (default is the project's sandbox/ folder)
ExecStart=/media/MySpace/Programming_Files/ransom_engine/.venv/bin/python -m engine.daemon
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
KillSignal=SIGTERM
Nice=5
NoNewPrivileges=true

[Install]
WantedBy=default.target
